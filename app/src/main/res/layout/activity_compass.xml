<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/arrow"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/arrow"
            android:src="@drawable/ic_arrow_up" />

        <RadioGroup
            android:id="@+id/modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/mode_magnetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_magnetic"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/mode_true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_true"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/mode_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_grid"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:id="@+id/declination_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/location_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/location_note"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="@string/save"
            android:textColor="@color/on_accent"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
